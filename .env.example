# Root-level environment for docker-compose variable substitution.
# Copy this file to .env (which is gitignored) and fill in real values.
#
# NOTE: this is Compose's own env file (same directory as docker-compose.yml),
# used for ${VAR} substitution INSIDE docker-compose.yml. It is separate from
# app/.env, which is bind-mounted into the app container (see the `app` service
# env_file). App/LLM secrets live in app/.env; compose-substitution secrets live
# here.

# SearXNG server.secret_key. Required — the stack refuses to start without it.
# Generate a fresh 64-hex value:  openssl rand -hex 32
SEARXNG_SECRET="replace_me_with_openssl_rand_hex_32"

# Local compose permits incomplete build identity and reports it as degraded.
# deploy/update.sh writes this as 1 for production, making missing SHA/image/
# prompt identity a hard readiness failure.
RELEASE_METADATA_REQUIRED="0"

# --- Canary fc pool (only needed for the `canary` profile) --------------------
# Consumed by the app-fc service in docker-compose.yml. Both are required to
# bring up the fc pool (`docker compose --profile canary up -d app-fc`) and are
# ignored by the default legacy-only stack.
#
# FC_CANARY_IMAGE: the IMMUTABLE, pre-built candidate image tag the fc pool runs
# (never :latest, never rebuilt from the tree). Build it out of band from the
# candidate tag — see docs/canary_runbook.md "Image build".
# FC_CANARY_SHA: the candidate commit sha; surfaced in X-Agent-Version and
# per-turn telemetry. Must match the sha the image was built from.
# FC_CANARY_IMAGE="uk-rent-agent:canary-fc-loop-<sha>"
# FC_CANARY_SHA="<sha>"

# Candidate runtime selector.  Omitting these preserves the previous rollout:
# fc_loop with manager specialists OFF and MCP OFF.  A manager-v1 trial must set
# the first two values together; CANARY_USE_MCP_TOOLS must stay 0.  The pair
# manager specialists + MCP is refused at CONFIG LOAD, before the server binds:
# the MCP client exposes neither specialist capability, so the manager graph
# cannot be constructed at all.  /ready reports the same message if the running
# process somehow serves tools over MCP anyway.
# CANARY_AGENT_ARCH="fc_loop"                  # fc_loop | manager_v1
# CANARY_MANAGER_V1_SPECIALISTS="0"            # use 1 only with manager_v1
#   Prefer exactly 0 or 1.  Every consumer now normalises the SAME set of
#   spellings: 1/true/yes/on and 0/false/no/off (and empty) -> 0/1.  Anything
#   outside that set is refused BY NAME by deploy/release.sh, deploy/update.sh,
#   deploy/set_canary_weight.sh, deploy/switch_pool.sh, the monitor and the app's
#   own config -- it used to silently derive a THIRD checkpoint database.
#   Until 2026-09-01 release.sh and update.sh compared the RAW string, so the
#   "true" this file blesses killed every deploy while everything else accepted it.
# CANARY_ALLOW_FLIP is deliberately NOT listed here: it is a one-shot command-line
#   prefix (CANARY_ALLOW_FLIP=1 bash deploy/release.sh) for an explicitly gated 100%
#   flip. Putting it in .env would permanently disable the 100% policy stop.
# CANARY_USE_MCP_TOOLS="0"

# Stable cohort salt used by deploy/set_canary_weight.sh.  Keep it unchanged
# while advancing 5 -> 20 -> 50 -> 100 so each larger stage is a superset of the
# previous cohort.  It is not a secret.
# CANARY_COHORT_SALT="rentcompass-v1"

# --- Legacy pool self-identification (OPTIONAL, fails safe) -------------------
# LEGACY_APP_SHA: the FULL 40-char commit sha the `app` (legacy pool) image was
# built from. Surfaced as APP_CANDIDATE_SHA -> X-Agent-Version, so the rollback
# target can prove which commit it runs and `deploy/switch_pool.sh --to legacy`
# no longer needs --allow-unidentified-target.
#
# Unlike FC_CANARY_* above this is NOT required: docker-compose.yml defaults it
# to empty (`${LEGACY_APP_SHA:-}`), which the app treats exactly like unset and
# reports as `unknown`. Leaving it out can never stop the legacy pool — the only
# rollback target — from starting. Never make it `:?`.
#
# Must be the full 40 chars: switch_pool.sh's provenance check compares length
# against 40, so a short sha is treated as unidentified. deploy/update.sh's pin
# gate guarantees the built commit is DEPLOY_PINNED_SHA from the server-local
# pin file (/etc/rentcompass/deploy.env) — copy that value here.
#
# Set this as part of a PLANNED public rebuild of `app`; it takes effect only
# when that container is next recreated.
# LEGACY_APP_SHA="<full 40-char sha>"
