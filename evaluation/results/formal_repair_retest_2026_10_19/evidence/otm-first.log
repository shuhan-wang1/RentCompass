            age = time.time() - verified.timestamp()
            if age < -300 or age > ROBOTS_POLICY_TTL_SECONDS:
                raise ValueError("expired")
        except (ValueError, TypeError, OverflowError) as exc:
            raise OTMSourceError("unavailable", "robots_policy_requires_verification") from exc
