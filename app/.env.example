# Copy this file to .env and fill in your real values. .env is gitignored.

# --- LLM provider -------------------------------------------------------------
# 'deepseek' (cloud, OpenAI-compatible) or 'ollama' (local)
LLM_PROVIDER="deepseek"

# DeepSeek API (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# This value must NEVER be a name the provider has retired. The authoritative list is
# RETIRED_MODEL_NAMES in src/uk_rent_agent/llm/router.py, and it is enforced two ways: at
# runtime every path that hands a model name to the provider refuses a retired one, and
# tests/test_model_name_defaults.py fails if any *.env.example in the tree carries one.
# This line used to read "deepseek-chat", which DeepSeek has since retired — so
# `cp app/.env.example app/.env` configured a model the provider rejects, and the
# only symptom was HTTP 400 at request time, which /health cannot see.
DEEPSEEK_MODEL="deepseek-v4-flash"

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:27b-cloud"

# Bound every provider request; retries stay small so the whole-turn deadline wins.
LLM_REQUEST_TIMEOUT_SECONDS="20"
LLM_MAX_RETRIES="1"

# Deterministic search is startup-safe without an embedding model. Enable eager
# RAG/pre-warm only with a provisioned cache or intentionally allowed downloads.
RAG_EAGER_INIT="0"
SEARCH_EMBED_PREWARM_ON_IMPORT="0"
SEARCH_EMBED_PREWARM="1"


# --- Maps / geo (now FREE: Nominatim/Postcodes.io + TfL + Overpass; no Google needed) ---
# Optional: a free TfL app key (https://api-portal.tfl.gov.uk) raises rate limits.
# TfL Journey Planner also works without it at low volume.
TFL_APP_KEY=""
# (legacy, no longer used by the app)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
OPENROUTESERVICE_API_KEY="your_openrouteservice_api_key_here"

# --- Optional -----------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# OnTheMarket: one identifiable programme client; all workers share refusal/pace state.
# Keep this path on writable persistent storage. Robots rules refresh after their TTL.
OTM_USER_AGENT=RentCompassBot/1.0
OTM_ACCESS_STATE_PATH=.runtime/otm_access.sqlite3
OTM_SEARCH_MAX_PAGES=2
