{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rentcompass.eval/benchmark/case.v4.schema.json",
  "title": "RentCompass held-out v4 case",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id", "schema_version", "task_category", "user_id", "user_query",
    "conversation_history", "expected_tools", "forbidden_tools", "expected_constraints",
    "hard_constraint_slots", "correct_completion", "completion_oracle", "metric_eligibility",
    "failure_conditions", "allowed_evidence_sources", "reference_calculations", "novelty_note", "fixture"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^HO4-[0-9]{3}$"},
    "schema_version": {"const": "rentcompass/benchmark/v4"},
    "task_category": {"enum": ["retrieval_hard", "retrieval_soft", "calculation", "memory", "clarify"]},
    "metric_eligibility": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["eligible_recall", "recommendation_precision", "complete_constraint_satisfaction", "required_tool_completion", "unsupported_numeric_control", "task_completion"]}
    },
    "completion_oracle": {"type": "object", "required": ["kind"]},
    "required_tool_contract": {"type": "object"},
    "fixture": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}
  }
}
